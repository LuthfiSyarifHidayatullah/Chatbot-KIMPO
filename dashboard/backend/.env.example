APP_NAME="KIMPO Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Database ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kimpo_dashboard
DB_USERNAME=root
DB_PASSWORD=

# ---------- Session / Cache ----------
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------- Broadcasting: Laravel Reverb ----------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=kimpo
REVERB_APP_KEY=kimpo_key
REVERB_APP_SECRET=kimpo_secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------- Integrasi Go Bot KIMPO ----------
# URL base bot Go (tanpa trailing slash).
CHATBOT_GO_URL=http://localhost:8080

# API key yang dikirim Go ke Laravel (webhook). Samakan dengan WEBHOOK_API_KEY di Go.
CHATBOT_WEBHOOK_KEY=ganti_dengan_key_rahasia_1

# API key yang dikirim Laravel ke Go (saat proxy /api/send, dll). Samakan dengan INBOUND_API_KEY di Go.
CHATBOT_GO_KEY=ganti_dengan_key_rahasia_2

# ---------- Sanctum (auth dashboard admin) ----------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost
SESSION_DOMAIN=localhost
